#!/usr/bin/env python3
"""rif — Read It Fast for the terminal.

RSVP (rapid serial visual presentation) speed reader: words flash one at a
time at a fixed pivot point, with the optimal-recognition-point letter
highlighted so your eyes never move.

Usage:
  rif FILE            read FILE
  ... | rif           read stdin
  rif --rm FILE       read FILE, delete it immediately (used by rif-tmux)

Keys:
  space     pause / resume (resume re-ramps speed)
  h / left  back one word        l / right  forward one word
  , or ;    previous sentence    .          next sentence
  k / up    faster (+25 wpm)     j / down   slower (-25 wpm)
  g         restart              q / esc    quit
"""

import argparse
import os
import re
import select
import shutil
import sys
import termios
import time
import tty

ANSI_RE = re.compile(r'\x1b(\[[0-9;?]*[ -/]*[@-~]|\][^\x07\x1b]*(\x07|\x1b\\)?|.)')
SENT_END = re.compile(r'[.!?…]["\'’”)\]]*$')
CLAUSE_END = re.compile(r'[,;:—–]["\'’”)\]]*$')

RED = '\x1b[1;31m'
DIM = '\x1b[2m'
REV = '\x1b[7m'
RST = '\x1b[0m'

MIN_WPM, MAX_WPM, WPM_STEP = 60, 1500, 25


def orp_index(word):
    l = len(word)
    if l <= 1:
        return 0
    if l <= 5:
        return 1
    if l <= 9:
        return 2
    if l <= 13:
        return 3
    return 4


def tokenize(text):
    """Return list of [word, is_paragraph_end]."""
    text = ANSI_RE.sub('', text)
    words = []
    for para in re.split(r'\n[ \t]*\n+', text):
        toks = para.split()
        for j, w in enumerate(toks):
            if len(w) > 18:
                parts = [w[k:k + 13] + ('-' if k + 13 < len(w) else '')
                         for k in range(0, len(w), 13)]
            else:
                parts = [w]
            for pi, p in enumerate(parts):
                words.append([p, j == len(toks) - 1 and pi == len(parts) - 1])
    return words


def delay_for(word, para_end, base):
    d = base
    if len(word) >= 8:
        d *= min(1.0 + (len(word) - 7) * 0.05, 1.5)
    if SENT_END.search(word):
        d *= 2.2
    elif CLAUSE_END.search(word):
        d *= 1.6
    if any(c.isdigit() for c in word):
        d *= 1.3
    if para_end:
        d *= 1.5
    return d


def ramp(streak):
    """Ease back up to full speed after a pause/start."""
    return (2.2, 1.8, 1.5, 1.3, 1.15)[streak] if streak < 5 else 1.0


class Keys:
    """Raw key input from the controlling terminal (not stdin, which may be a pipe)."""

    def __init__(self):
        self.fd = None
        self.saved = None
        try:
            self.fd = os.open('/dev/tty', os.O_RDONLY)
            self.saved = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
        except Exception:
            if self.fd is not None:
                os.close(self.fd)
            self.fd = None

    @property
    def ok(self):
        return self.fd is not None

    def get(self, timeout):
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            return None
        b = os.read(self.fd, 1)
        if b == b'\x1b':
            r, _, _ = select.select([self.fd], [], [], 0.03)
            if r:
                seq = os.read(self.fd, 2)
                return {b'[A': 'UP', b'[B': 'DOWN',
                        b'[C': 'RIGHT', b'[D': 'LEFT'}.get(seq)
            return '\x1b'
        try:
            return b.decode()
        except UnicodeDecodeError:
            return None

    def close(self):
        if self.fd is not None:
            try:
                termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
            finally:
                os.close(self.fd)
            self.fd = None


def draw(words, i, wpm, playing, done):
    cols, rows = shutil.get_terminal_size()
    pivot = max(12, cols // 2)
    word = words[i][0]
    o = orp_index(word)
    arm = min(12, pivot - 2)

    top = ' ' * (pivot - arm) + DIM + '─' * arm + '┬' + '─' * arm + RST
    bot = ' ' * (pivot - arm) + DIM + '─' * arm + '┴' + '─' * arm + RST
    left, mid, right = word[:o], word[o:o + 1], word[o + 1:]
    wline = ' ' * max(0, pivot - len(left)) + left + RED + mid + RST + right

    pad_top = max(0, rows // 2 - 3)
    buf = ['\x1b[2J\x1b[H', '\r\n' * pad_top,
           top, '\r\n\r\n', wline, '\r\n\r\n', bot]

    if not playing and not done:
        lo, hi = max(0, i - 8), min(len(words), i + 9)
        parts = []
        for j in range(lo, hi):
            w = words[j][0]
            parts.append(RST + REV + w + RST + DIM if j == i else w)
        ctx = (DIM + ('… ' if lo else '') + ' '.join(parts)
               + (' …' if hi < len(words) else '') + RST)
        buf.append('\r\n\r\n  ' + ctx[:cols * 4])

    pct = (i + 1) * 100 // len(words)
    state = 'done — space replays' if done else ('paused' if not playing else '')
    status = f' {wpm} wpm · {i + 1}/{len(words)} ({pct}%)  {state}'
    keys_help = ' space pause · h/l word · ,/. sentence · j/k speed · g restart · q quit'
    buf.append(f'\x1b[{max(1, rows - 1)};1H{DIM}{status}{RST}')
    buf.append(f'\x1b[{rows};1H{DIM}{keys_help[:cols - 1]}{RST}')
    sys.stdout.write(''.join(buf))
    sys.stdout.flush()


def main():
    ap = argparse.ArgumentParser(prog='rif', description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('file', nargs='?', help='text file (default: stdin)')
    ap.add_argument('-w', '--wpm', type=int,
                    default=int(os.environ.get('RIF_WPM', 350)),
                    help='words per minute (default 350, or $RIF_WPM)')
    ap.add_argument('--rm', action='store_true',
                    help='delete FILE after reading it in')
    a = ap.parse_args()

    if a.file:
        with open(a.file, errors='replace') as f:
            text = f.read()
        if a.rm:
            try:
                os.unlink(a.file)
            except OSError:
                pass
    else:
        text = sys.stdin.read()

    words = tokenize(text)
    if not words:
        sys.exit('rif: no text to read')

    sent_starts = [0] + [j for j in range(1, len(words))
                         if SENT_END.search(words[j - 1][0])]

    def prev_sentence(i):
        cands = [s for s in sent_starts if s < i - 1]
        return cands[-1] if cands else 0

    def next_sentence(i):
        cands = [s for s in sent_starts if s > i]
        return cands[0] if cands else len(words) - 1

    wpm = max(MIN_WPM, min(MAX_WPM, a.wpm))
    i, playing, done, streak = 0, True, False, 0
    keys = Keys()

    try:
        sys.stdout.write('\x1b[?1049h\x1b[?25l')
        while True:
            draw(words, i, wpm, playing, done)
            k = None
            if playing and not done:
                deadline = time.monotonic() + delay_for(
                    words[i][0], words[i][1], 60.0 / wpm) * ramp(streak)
                while k is None:
                    t = deadline - time.monotonic()
                    if t <= 0:
                        break
                    if keys.ok:
                        k = keys.get(t)
                    else:
                        time.sleep(t)
                if k is None:
                    streak += 1
                    if i + 1 >= len(words):
                        done, playing = True, False
                    else:
                        i += 1
                    continue
            else:
                if not keys.ok:
                    break
                k = keys.get(None)

            if k in ('q', '\x1b', '\x03'):
                break
            if k == ' ':
                if done:
                    i, done, playing, streak = 0, False, True, 0
                else:
                    playing = not playing
                    streak = 0
            elif k in ('l', 'RIGHT'):
                i, done = min(i + 1, len(words) - 1), False
            elif k in ('h', 'LEFT'):
                i, done = max(i - 1, 0), False
            elif k in ('k', 'UP'):
                wpm = min(wpm + WPM_STEP, MAX_WPM)
            elif k in ('j', 'DOWN'):
                wpm = max(wpm - WPM_STEP, MIN_WPM)
            elif k in (',', ';'):
                i, done, streak = prev_sentence(i), False, 0
            elif k == '.':
                i, done, streak = next_sentence(i), False, 0
            elif k == 'g':
                i, done, streak = 0, False, 0
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write('\x1b[?25h\x1b[?1049l')
        sys.stdout.flush()
        keys.close()


if __name__ == '__main__':
    main()
