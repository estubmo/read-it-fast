#!/usr/bin/env python3
"""rif — Read It Fast for the terminal.

RSVP (rapid serial visual presentation) speed reader: words flash one at a
time at a fixed pivot point, with the optimal-recognition-point letter
highlighted so your eyes never move.

Usage:
  rif FILE            read FILE
  ... | rif           read stdin
  rif --rm FILE       read FILE, delete it immediately (used by rif-tmux)

Keys:
  space     pause / resume (resume re-ramps speed)
  h / left  back one word        l / right  forward one word
  , or ;    previous sentence    .          next sentence
  k / up    faster (+25 wpm)     j / down   slower (-25 wpm)
  + / -     bigger / smaller text (1 = plain, 2+ = block glyphs)
  g         restart              q / esc    quit

Speed and text size persist across runs in ~/.config/rif/config.
"""

import argparse
import os
import re
import select
import shutil
import sys
import termios
import time
import tty

ANSI_RE = re.compile(r'\x1b(\[[0-9;?]*[ -/]*[@-~]|\][^\x07\x1b]*(\x07|\x1b\\)?|.)')
SENT_END = re.compile(r'[.!?…]["\'’”)\]]*$')
CLAUSE_END = re.compile(r'[,;:—–]["\'’”)\]]*$')

RED = '\x1b[1;31m'
DIM = '\x1b[2m'
REV = '\x1b[7m'
RST = '\x1b[0m'

MIN_WPM, MAX_WPM, WPM_STEP = 60, 1500, 25
MIN_SCALE, MAX_SCALE = 1, 5  # 1 = plain terminal text, 2+ = block glyphs

# Classic 5x7 bitmap font (ASCII 32-126), column-major, bit 0 = top row.
# Extracted from Adafruit-GFX glcdfont.c (BSD license).
FONT5X7 = (
