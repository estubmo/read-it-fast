# scale -> (font, pixel multiplier). Big sizes use larger native fonts so
# letterforms stay smooth; only 6 and 7 pixel-double.
SCALES = {2: ('6x12', 1), 3: ('8x16', 1), 4: ('12x24', 1),
          5: ('16x32', 1), 6: ('12x24', 2), 7: ('16x32', 2)}

_GLYPH_CACHE = {}


def glyphs_for(name):
    if name not in _GLYPH_CACHE:
        W, H, b64 = SPLEEN[name]
        raw = zlib.decompress(base64.b64decode(b64))
        nb = (W + 7) // 8
        _GLYPH_CACHE[name] = [
            [int.from_bytes(raw[(i * H + r) * nb:(i * H + r + 1) * nb], 'big')
             for r in range(H)]
            for i in range(95)]
    return _GLYPH_CACHE[name]

# Display-only fallbacks for common non-ASCII so big mode never breaks.
BITMAP_TRANS = str.maketrans({'’': "'", '‘': "'", '“': '"', '”': '"',
                              '—': '-', '–': '-', '…': '.', '•': '*',
                              '«': '"', '»': '"', '´': "'", '`': "'"})


def orp_index(word):
    l = len(word)
    if l <= 1:
        return 0
    if l <= 5:
        return 1
    if l <= 9:
        return 2
    if l <= 13:
        return 3
    return 4


def tokenize(text):
    """Return list of [word, is_paragraph_end]."""
    text = ANSI_RE.sub('', text)
    words = []
    for para in re.split(r'\n[ \t]*\n+', text):
        toks = para.split()
        for j, w in enumerate(toks):
            if len(w) > 18:
                parts = [w[k:k + 13] + ('-' if k + 13 < len(w) else '')
                         for k in range(0, len(w), 13)]
            else:
                parts = [w]
            for pi, p in enumerate(parts):
                words.append([p, j == len(toks) - 1 and pi == len(parts) - 1])
    return words


def delay_for(word, para_end, base):
    d = base
    if len(word) >= 8:
        d *= min(1.0 + (len(word) - 7) * 0.05, 1.5)
    if SENT_END.search(word):
        d *= 2.2
    elif CLAUSE_END.search(word):
        d *= 1.6
    if any(c.isdigit() for c in word):
        d *= 1.3
    if para_end:
        d *= 1.5
    return d


def ramp(streak):
    """Ease back up to full speed after a pause/start."""
    return (2.2, 1.8, 1.5, 1.3, 1.15)[streak] if streak < 5 else 1.0


def config_path():
    return os.path.join(os.environ.get('XDG_CONFIG_HOME',
                        os.path.expanduser('~/.config')), 'rif', 'config')


def load_config():
    cfg = {}
    try:
        with open(config_path()) as f:
            for ln in f:
                if '=' in ln:
                    k, v = ln.split('=', 1)
                    cfg[k.strip()] = v.strip()
    except OSError:
        pass
    return cfg


def save_config(wpm, scale):
    try:
        os.makedirs(os.path.dirname(config_path()), exist_ok=True)
        with open(config_path(), 'w') as f:
            f.write(f'wpm={wpm}\nscale={scale}\n')
    except OSError:
        pass


def render_big(word, o, scale):
    """Render word as half-block glyph lines for the given scale level.

    Returns (lines, orp_center) — ANSI-colored lines with no indent, and the
    cell column of the ORP letter's center within them.
    """
    fname, ps = SCALES[scale]
    W, H, _ = SPLEEN[fname]
    glyphs = glyphs_for(fname)
    word = word.translate(BITMAP_TRANS)
    cw = W * ps
    width, grid_h = cw * len(word), H * ps
    grid = [[0] * width for _ in range(grid_h + grid_h % 2)]
    for ci, ch in enumerate(word):
        gi = ord(ch) - 32
        rows = glyphs[gi] if 0 <= gi < 95 else glyphs[ord('?') - 32]
        val = 2 if ci == o else 1
        for y in range(H):
            bits = rows[y]
            if not bits:
                continue
            for x in range(W):
                if (bits >> (W - 1 - x)) & 1:
                    for dy in range(ps):
                        row = grid[y * ps + dy]
                        for dx in range(ps):
                            row[ci * cw + x * ps + dx] = val
    lines = []
    for r in range(0, grid_h + grid_h % 2, 2):
        top, bot, out, cur = grid[r], grid[r + 1], [], None
        for x in range(width):
            t, b = top[x], bot[x]
            ch = (' ', '▀', '▄', '█')[(1 if t else 0) + (2 if b else 0)]
            if ch != ' ':
                col = 2 if 2 in (t, b) else 1
                if col != cur:
                    out.append(RED if col == 2 else RST)
                    cur = col
            out.append(ch)
        lines.append(''.join(out) + RST)
    return lines, o * cw + cw // 2


class Keys:
    """Raw key input from the controlling terminal (not stdin, which may be a pipe)."""

    def __init__(self):
        self.fd = None
        self.saved = None
        try:
            self.fd = os.open('/dev/tty', os.O_RDONLY)
            self.saved = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
        except Exception:
            if self.fd is not None:
                os.close(self.fd)
            self.fd = None

    @property
    def ok(self):
        return self.fd is not None

    def get(self, timeout):
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            return None
        b = os.read(self.fd, 1)
        if b == b'\x1b':
            r, _, _ = select.select([self.fd], [], [], 0.03)
            if r:
                seq = os.read(self.fd, 2)
                return {b'[A': 'UP', b'[B': 'DOWN',
                        b'[C': 'RIGHT', b'[D': 'LEFT'}.get(seq)
            return '\x1b'
        try:
            return b.decode()
        except UnicodeDecodeError:
            return None

    def close(self):
        if self.fd is not None:
            try:
                termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
            finally:
                os.close(self.fd)
            self.fd = None


def draw(words, i, wpm, scale, playing, done):
    cols, rows = shutil.get_terminal_size()
    pivot = max(12, cols // 2)
    word = words[i][0]
    o = orp_index(word)

    # Auto-fit: step down the size ladder until the word fits this terminal.
    eff = scale
    while eff > 1:
        fname, ps = SCALES[eff]
        W, H, _ = SPLEEN[fname]
        if W * ps * len(word) <= cols - 2 and H * ps // 2 + 7 <= rows:
            break
        eff -= 1

    if eff > 1:
        glines, orp_center = render_big(word, o, eff)
        indent = ' ' * max(0, pivot - orp_center)
        body = ['\r\n'] + [indent + ln + '\r\n' for ln in glines] + ['\r\n']
        fname, ps = SCALES[eff]
        word_w = SPLEEN[fname][0] * ps * len(word)
    else:
        left, mid, right = word[:o], word[o:o + 1], word[o + 1:]
        body = ['\r\n', ' ' * max(0, pivot - len(left))
                + left + RED + mid + RST + right + '\r\n', '\r\n']
        word_w = len(word)

    arm = max(12, min(word_w // 2 + 2, pivot - 1, cols - pivot - 2))
    top = ' ' * (pivot - arm) + DIM + '─' * arm + '┬' + '─' * arm + RST
    bot = ' ' * (pivot - arm) + DIM + '─' * arm + '┴' + '─' * arm + RST

    pad_top = max(0, (rows - len(body) - 4) // 2)
    buf = ['\x1b[2J\x1b[H', '\r\n' * pad_top, top, '\r\n']
    buf.extend(body)
    buf.append(bot)

    if not playing and not done:
        lo, hi = max(0, i - 8), min(len(words), i + 9)
        parts = []
        for j in range(lo, hi):
            w = words[j][0]
            parts.append(RST + REV + w + RST + DIM if j == i else w)
        ctx = (DIM + ('… ' if lo else '') + ' '.join(parts)
               + (' …' if hi < len(words) else '') + RST)
        buf.append('\r\n\r\n  ' + ctx[:cols * 4])

    pct = (i + 1) * 100 // len(words)
    state = 'done — space replays' if done else ('paused' if not playing else '')
    status = f' {wpm} wpm · ×{scale} · {i + 1}/{len(words)} ({pct}%)  {state}'
    keys_help = (' space pause · h/l word · ,/. sentence · j/k speed'
                 ' · +/- size · g restart · q quit')
    buf.append(f'\x1b[{max(1, rows - 1)};1H{DIM}{status}{RST}')
    buf.append(f'\x1b[{rows};1H{DIM}{keys_help[:cols - 1]}{RST}')
    sys.stdout.write(''.join(buf))
    sys.stdout.flush()


def main():
    ap = argparse.ArgumentParser(prog='rif', description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('file', nargs='?', help='text file (default: stdin)')
    ap.add_argument('-w', '--wpm', type=int, default=None,
                    help='words per minute (default: saved config, $RIF_WPM, or 350)')
    ap.add_argument('-s', '--scale', type=int, default=None,
                    help=f'text size {MIN_SCALE}-{MAX_SCALE}; 1 = normal terminal '
                         'text, 2-7 = bitmap glyphs (default: saved config, or 3)')
    ap.add_argument('--rm', action='store_true',
                    help='delete FILE after reading it in')
    a = ap.parse_args()

    cfg = load_config()

    if a.file:
        with open(a.file, errors='replace') as f:
            text = f.read()
        if a.rm:
            try:
                os.unlink(a.file)
            except OSError:
                pass
    else:
        text = sys.stdin.read()

    words = tokenize(text)
    if not words:
        sys.exit('rif: no text to read')

    sent_starts = [0] + [j for j in range(1, len(words))
                         if SENT_END.search(words[j - 1][0])]

    def prev_sentence(i):
        cands = [s for s in sent_starts if s < i - 1]
        return cands[-1] if cands else 0

    def next_sentence(i):
        cands = [s for s in sent_starts if s > i]
        return cands[0] if cands else len(words) - 1

    def cfg_int(key, fallback):
        try:
            return int(cfg.get(key, fallback))
        except ValueError:
            return int(fallback)

    wpm = a.wpm if a.wpm is not None else cfg_int(
        'wpm', os.environ.get('RIF_WPM', 350))
    wpm = max(MIN_WPM, min(MAX_WPM, wpm))
    scale = a.scale if a.scale is not None else cfg_int('scale', 3)
    scale = max(MIN_SCALE, min(MAX_SCALE, scale))

    i, playing, done, streak = 0, True, False, 0
    keys = Keys()

    try:
        sys.stdout.write('\x1b[?1049h\x1b[?25l')
        while True:
            draw(words, i, wpm, scale, playing, done)
            k = None
            if playing and not done:
                deadline = time.monotonic() + delay_for(
                    words[i][0], words[i][1], 60.0 / wpm) * ramp(streak)
                while k is None:
                    t = deadline - time.monotonic()
                    if t <= 0:
                        break
                    if keys.ok:
                        k = keys.get(t)
                    else:
                        time.sleep(t)
                if k is None:
                    streak += 1
                    if i + 1 >= len(words):
                        done, playing = True, False
                    else:
                        i += 1
                    continue
            else:
                if not keys.ok:
                    break
                k = keys.get(None)

            if k in ('q', '\x1b', '\x03'):
                break
            if k == ' ':
                if done:
                    i, done, playing, streak = 0, False, True, 0
                else:
                    playing = not playing
                    streak = 0
            elif k in ('l', 'RIGHT'):
                i, done = min(i + 1, len(words) - 1), False
            elif k in ('h', 'LEFT'):
                i, done = max(i - 1, 0), False
            elif k in ('k', 'UP'):
                wpm = min(wpm + WPM_STEP, MAX_WPM)
            elif k in ('j', 'DOWN'):
                wpm = max(wpm - WPM_STEP, MIN_WPM)
            elif k in ('+', '='):
                scale = min(scale + 1, MAX_SCALE)
            elif k in ('-', '_'):
                scale = max(scale - 1, MIN_SCALE)
            elif k in (',', ';'):
                i, done, streak = prev_sentence(i), False, 0
            elif k == '.':
                i, done, streak = next_sentence(i), False, 0
            elif k == 'g':
                i, done, streak = 0, False, 0
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write('\x1b[?25h\x1b[?1049l')
        sys.stdout.flush()
        keys.close()
        save_config(wpm, scale)


if __name__ == '__main__':
    main()
